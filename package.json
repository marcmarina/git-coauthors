{
  "name": "git-coauthors",
  "version": "0.5.6",
  "keywords": [
    "git",
    "cli"
  ],
  "bugs": {
    "url": "https://github.com/marcmarina/git-coauthors/issues"
  },
  "repository": "https://github.com/marcmarina/git-coauthors",
  "license": "MIT",
  "author": "Marc Marina",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "git-coauthors": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "db:generate-schema": "drizzle-kit --config=src/database/drizzle.config.ts generate",
    "db:migrate": "drizzle-kit --config=src/database/drizzle.config.ts migrate",
    "drizzle-kit": "drizzle-kit --config=src/database/drizzle.config.ts",
    "lint": "eslint . --ext .ts",
    "prepare": "husky install",
    "start": "ts-node src/index.ts",
    "test": "jest --passWithNoTests",
    "verify": "pnpm run build --noEmit && pnpm run lint && pnpm run test"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "better-sqlite3": "^11.10.0",
    "chalk": "^4.1.2",
    "clipboardy": "^2.3.0",
    "commander": "^9.5.0",
    "drizzle-orm": "^0.33.0",
    "drizzle-zod": "^0.5.1",
    "lodash": "^4.17.21",
    "prompts": "^2.4.2",
    "simple-git": "^3.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/commander": "^2.12.5",
    "@types/jest": "29.5.4",
    "@types/lodash": "^4.17.20",
    "@types/node": "^16.18.126",
    "@types/prompts": "^2.4.9",
    "@typescript-eslint/eslint-plugin": "5.61.0",
    "@typescript-eslint/parser": "5.61.0",
    "drizzle-kit": "^0.24.2",
    "eslint": "8.44.0",
    "eslint-plugin-import": "^2.32.0",
    "husky": "8.0.3",
    "jest": "29.6.4",
    "lint-staged": "13.2.3",
    "prettier": "3.2.4",
    "sort-package-json": "^2.15.1",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^4.9.5"
  }
}
